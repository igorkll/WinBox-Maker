Windows Registry Editor Version 5.00

; ------------------------------------------------ software hive

; ---------------- disable telemetry
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]
"AllowTelemetry"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Windows Error Reporting]
"Disable"=dword:00000001
"Disabled"=dword:00000001
"DontShowUI"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps]
"DumpType"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\ScriptedDiagnosticsProvider\Policy]
;Не обращаться к средствам устранения неполадок через интернет
"EnableQueryRemoteServer"=dword:00000000

; ---------------- disable windows defender
; БЛЯТЬ, ебанавинда не дает писать в эти разделы ДАЖЕ В СМОНТИРОВАНОМ БЛЯТЬ РЕЕСТРЕ! microsoft, BRUHHHHHHHHHHHHH
; нада будет походу свою либу писать чтобы файлы реестера патчить
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender]
"DisableAntiSpyware"=dword:00000001
"DisableAntiVirus"=dword:00000001
"DisableRealtimeMonitoring"=dword:00000001
"DisableBehaviorMonitoring"=dword:00000001
"DisableOnAccessProtection"=dword:00000001
"DisableScanOnRealtimeEnable"=dword:00000001
"DisableIOAVProtection"=dword:00000001
"DisableSpecialRunningModes"=dword:00000001
"DisableRoutinelyTakingAction"=dword:00000001
"ServiceKeepAlive"=dword:00000000
"DisableBlockAtFirstSeen"=dword:00000001
"DisableEnhancedNotifications"=dword:00000001
"DpaDisabled"=dword:00000001
"VerifiedAndReputableTrustModeEnabled"=dword:00000001
"ProductAppDataPath"=" *|%@^&\\/! +- ~"
"RemediationExe"=" *|%@^&\\/! +- ~"
"ProductLocalizedName"=" *|%@^&\\/! +- ~"
"ProductIcon"=" *|%@^&\\/! +- ~"
"InstallLocation"=" *|%@^&\\/! +- ~"
"BackupLocation"=" *|%@^&\\/! +- ~"
"HybridModeEnabled"=dword:00000000
"AllowFastServiceStartup"=dword:00000000
"ServiceKeepAlive"=dword:00000000
"LocalSettingOverrideSpynetReporting"=dword:00000000
"SubmitSamplesConsent"=dword:00000002

