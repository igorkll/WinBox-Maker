Windows Registry Editor Version 5.00

; ---------------- disable telemetry
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\DataCollection]
"AllowTelemetry"=dword:00000000

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\Windows Error Reporting]
"Disable"=dword:00000001
"Disabled"=dword:00000001
"DontShowUI"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps]
"DumpType"=dword:00000000

; ---------------- disable windows defender
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows Defender]
"DisableAntiSpyware"=dword:00000001
"DisableAntiVirus"=dword:00000001
"DisableRealtimeMonitoring"=dword:00000001
"DisableBehaviorMonitoring"=dword:00000001
"DisableOnAccessProtection"=dword:00000001
"DisableScanOnRealtimeEnable"=dword:00000001
"DisableIOAVProtection"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection]
"DisableAntiSpyware"=dword:00000001
"DisableAntiVirus"=dword:00000001
"DisableRealtimeMonitoring"=dword:00000001
"DisableBehaviorMonitoring"=dword:00000001
"DisableOnAccessProtection"=dword:00000001
"DisableScanOnRealtimeEnable"=dword:00000001
"DisableIOAVProtection"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows Defender\Policy Manager]
"DisableAntiSpyware"=dword:00000001
"DisableAntiVirus"=dword:00000001
"DisableRealtimeMonitoring"=dword:00000001
"DisableBehaviorMonitoring"=dword:00000001
"DisableOnAccessProtection"=dword:00000001
"DisableScanOnRealtimeEnable"=dword:00000001
"DisableIOAVProtection"=dword:00000001

; ---------------- disable updates
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate]
"DisableWindowsUpdateAccess"=dword:00000001
"DoNotConnectToWindowsUpdateInternetLocations"=dword:00000001
"SetDisableUXWUAccess"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU]
"AUOptions"=dword:00000001
"NoAutoUpdate"=dword:00000001
"NoAutoRebootWithLoggedOnUsers"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update]
"AUState"=dword:00000000

; ---------------- disable UAC
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"EnableLUA"=dword:00000000
"ConsentPromptBehaviorAdmin"=dword:00000000
"ConsentPromptBehaviorUser"=dword:00000000
"PromptOnSecureDesktop"=dword:00000000

; ----------------
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows NT\CurrentVersion\SoftwareProtectionPlatform\Activation]
"ActivationInterval"=dword:000dbba0
"Manual"=dword:00000001
"NotificationDisabled"=dword:00000001
"DownlevelActivation"=dword:00000002

; ---------------- disable screenshot
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableSnippingTool"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\Explorer]
"DisableSnippingTool"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\TabletPC]
"DisableSnippingTool"=dword:00000001

; ---------------- disable lockscreen
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\SessionData]
"AnimationDisabled"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\SessionData]
"AllowLockScreen"=dword:00000000

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\ClearAutologon]
"Enabled"=dword:00000000

[HLEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\Personalization]
"NoLockScreen"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon]
"DisableLockWorkstation"=dword:00000001
"DisableCad"=dword:00000001
"EnableFirstLogonAnimation"=dword:00000000
"DisableBackButton"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"EnableFirstLogonAnimation"=dword:00000000
"HideFastUserSwitching"=dword:00000001
"DisableLockWorkstation"=dword:00000001
"DontDisplayLastUserName"=dword:00000001
"DontDisplayNetworkSelectionUI"=dword:00000001
"shutdownwithoutlogon"=dword:00000000
"undockwithoutlogon"=dword:00000000
"DisableCAD"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\System]
"DisableLockScreen"=dword:00000001
"DisableLogonBackgroundImage"=dword:00000001
"DontDisplayNetworkSelectionUI"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows Embedded\EmbeddedLogon]
"HideAutoLogonUI"=dword:00000001
"HideFirstLogonAnimation"=dword:00000001
"BrandingNeutral"=dword:00000001
"NoLockScreen"=dword:00000001
"AnimationDisabled"=dword:00000001
"UIVerbosityLevel"=dword:00000001

; ---------------- disable sounds
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\BootAnimation]
"DisableStartupSound"=dword:00000001

; ---------------- setup winlogon
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon] 
"AutoAdminLogon"="1"
"ForceAutoLogon"="1"
"UIVerbosityLevel"=dword:00000001
"DefaultUserName"="winbox"
"DefaultPassword"=""

; ---------------- setup oobe
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE]
"SkipMachineOOBE"=dword:00000001
"SkipUserOOBE"=dword:00000001
"BypassNRO"=dword:00000001

; ---------------- disable ctrl+alt+del functionality
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableLogoff"=dword:00000001
"DisableChangePassword"=dword:00000001
"DontDisplayNetworkSelectionUI"=dword:00000001

; ---------------- disable sfc
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableSFC"=dword:00000001
"SFCDisable"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon]
"DisableSFC"=dword:00000001
"SFCDisable"=dword:00000001

; ---------------- disabling the verification of the signature of exe files
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"VerifySignatures"=dword:00000000

; ---------------- disable animations
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"TaskbarAnimations"=dword:0

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects]
"VisualFXSetting"=dword:3

; ---------------- disable edge hotkeys
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Edge]
"ConfigureKeyboardShortcuts"="{\"disabled\": [\"new_tab\", \"fullscreen\", \"close_tab\", \"zoom_reset\", \"zoom_out\", \"zoom_in\", \"web_select\", \"web_capture\", \"view_source\", \"vertical_tabs_toggle\", \"task_manager\", \"system_print\", \"sidebar_search_selected_text\", \"show_favorites_bar_toggle\", \"settings_and_more_menu\", \"send_feedback\", \"select_previous_tab\", \"select_next_tab\", \"select_last_tab\", \"save_page\", \"reopen_tab\", \"refresh_bypassing_cache\", \"refresh\", \"read_aloud_toggle\", \"profile\", \"print\", \"paste_and_go\", \"open_file\", \"new_window\", \"new_tab\", \"new_inprivate_window\", \"new_application_guard_window\", \"mute_tab_toggle\", \"immersive_reader_toggle\", \"home\", \"history\", \"help_page\", \"forward\", \"focus_web_pane\", \"focus_settings_and_more\", \"focus_search\", \"focus_reading_bar\", \"focus_previous_pane\", \"focus_next_pane\", \"focus_inactive_notification\", \"focus_favorites\", \"focus_app_toolbar\", \"focus_address_bar\", \"find_previous\", \"find_next\", \"find\", \"favorites\", \"favorite_this_tab\", \"favorite_all_tabs\", \"duplicate_tab\", \"downloads\", \"dev_tools_toggle\", \"dev_tools_elements\", \"dev_tools_console\", \"dev_tools\", \"collections\", \"close_window\", \"close_find_or_stop\", \"clear_browsing_data\", \"caret_browsing_toggle\", \"back\"]}"

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows\EdgeUI]
"AllowEdgeSwipe"=dword:00000000

; ---------------- disable edge updates
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Edge]
"ComponentUpdatesEnabled"=dword:0
"Update"=dword:0
"AutoUpdate"=dword:0
"UpdateDefault"=dword:0
"DoNotUpdateToEdgeWithChromium"=dword:1

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\EdgeUpdate]
"ComponentUpdatesEnabled"=dword:0
"Update"=dword:0
"AutoUpdate"=dword:0
"UpdateDefault"=dword:0
"DoNotUpdateToEdgeWithChromium"=dword:1

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\EdgeUpdate]
"ComponentUpdatesEnabled"=dword:0
"Update"=dword:0
"AutoUpdate"=dword:0
"UpdateDefault"=dword:0
"DoNotUpdateToEdgeWithChromium"=dword:1

; ---------------- disable edge translate
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Edge]
"TranslateEnabled"=dword:0

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Edge\Recommended]
"TranslateEnabled"=dword:0

; ---------------- disable edge sync
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Edge]
"SyncDisabled"=dword:1

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Edge\Recommended]
"SyncDisabled"=dword:1

; ---------------- disable smart screen
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
"SmartScreenEnabled"="Off"

; ---------------- disable auto task kill
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\RADAR\HeapLeakDetection]
"DisableHLT"=dword:00000001

; ---------------- disabling the damn safety notifications (when working with the enabled explorer.exe)
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer]
"NoSecuritySettingsCheck"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows Defender Security Center\Notifications]
"DisableNotifications"=dword:00000001

[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Policies\Microsoft\Windows Defender Security Center\Notifications]
"DisableNotifications"=dword:00000001

; ---------------- a fix for UWP apps
[HKEY_LOCAL_MACHINE\WINBOX_SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"FilterAdministratorToken"=dword:00000001
